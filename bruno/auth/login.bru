meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/sign-in/email
  body: json
  auth: inherit
}

body:json {
  {
    "email": "tess.cremin@gmail.com", 
    "password": "Teste123", 
    "callbackURL": "/"
  }
}

script:post-response {
  const token = res.body?.token || res.body?.session?.token;
  if (token) {
    bru.setVar("sessionValue", token);
  } else {
    console.log("No token found in response");
  }
}
